{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ens-cli-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ens-cli-feedback",
      // Create with `bunx wrangler d1 create ens-cli-feedback` and paste the id here
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
