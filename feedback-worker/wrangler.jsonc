{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ens-cli-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ens-cli-feedback",
      "database_id": "57f651bc-c80e-40cc-a710-98a2d961256d",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Arbitrary id, unique within the Cloudflare account
      "namespace_id": "1001",
      // 5 requests per IP per minute (period must be 10 or 60 seconds)
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
